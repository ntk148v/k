# OpenAI API configuration
# Get your key from https://platform.openai.com/api-keys
# Also works with any OpenAI-compatible provider (OpenRouter, xAI, local LLMs, etc.)
OPENAI_API_KEY=sk-your-key-here

# Base URL for the API (optional — omit for OpenAI, or set for other providers)
# Examples:
#   OpenRouter:   https://openrouter.ai/api/v1
#   xAI:          https://api.x.ai/v1
#   Local Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model name to use (default: openrouter/free)
OPENAI_MODEL_NAME=openrouter/free

# k theme: "light" or "dark" (default: light)
# K_THEME=dark
